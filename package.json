{
  "name": "we3d",
  "version": "0.0.3",
  "type": "module",
  "main": "./dist/we3d.js",
  "module": "./dist/we3d.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/we3d.js"
    }
  },
  "files": [
    "dist",
    "public/draco",
    "public/basis",
    "public/IBL/brdfLut/dfg_lut_128.hdr"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/build-draco-worker.mjs",
    "build:draco-worker": "node scripts/build-draco-worker.mjs",
    "preview": "vite preview",
    "examples:generate": "node scripts/generate-examples-json.mjs",
    "e2e-index": "node scripts/generate-e2e-index.mjs",
    "docs:build": "node scripts/docs-if-new.mjs",
    "docs:build:force": "typedoc",
    "docs:build:watch": "typedoc --watch",
    "lint": "eslint src/we",
    "lint:fix": "eslint src/we --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:quality": "node scripts/check-code-quality.mjs",
    "quality:baseline": "node scripts/check-code-quality.mjs --update",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:software": "playwright test -c playwright.software.config.ts",
    "test:baseline": "playwright test --update-snapshots",
    "check:exports": "node scripts/check-exports.mjs",
    "optimize:gltf": "node scripts/optimize-gltf.mjs",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run format:check && npm run check:quality && npm run typecheck && npm run test:run && npm run test:browser && npm run check:exports && npm run build:lib && npm run test:e2e",
    "ci:no-e2e": "npm run lint && npm run format:check && npm run check:quality && npm run typecheck && npm run test:run && npm run test:browser && npm run check:exports && npm run build:lib",
    "publish:if-new": "node scripts/npm-publish-if-new.mjs",
    "prepublishOnly": "npm run lint && npm run check:quality && npm run test:run && npm run build:lib && npm run check:exports"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/seedrandom": "^3.0.8",
    "@types/stats.js": "^0.17.4",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "@webgpu/types": "^0.1.70",
    "draco3dgltf": "^1.5.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "hash-wasm": "^4.12.0",
    "lil-gui": "^0.17.0",
    "muigui": "^0.0.22",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rollup": "^4.48.1",
    "seedrandom": "^3.0.5",
    "stats.js": "^0.17.0",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.28.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "hdrify": "^0.12.1",
    "js-md5": "^0.8.3",
    "ktx-parse": "^1.1.0",
    "meshoptimizer": "^1.3.0",
    "webgpu-utils": "^1.11.0",
    "wgpu-matrix": "^3.4.0"
  }
}
