{
  "name": "we3d",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/we3d.js",
  "module": "./dist/we3d.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/we3d.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "examples:generate": "node scripts/generate-examples-json.mjs",
    "docs:build": "typedoc",
    "docs:build:watch": "typedoc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:baseline": "playwright test --update-snapshots",
    "check:exports": "node scripts/check-exports.mjs",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build:lib && npm run check:exports"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/seedrandom": "^3.0.8",
    "@types/stats.js": "^0.17.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@webgpu/types": "^0.1.70",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "hash-wasm": "^4.12.0",
    "lil-gui": "^0.17.0",
    "muigui": "^0.0.22",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rollup": "^4.48.1",
    "seedrandom": "^3.0.5",
    "stats.js": "^0.17.0",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.28.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.2",
    "@loaders.gl/compression": "4.3.4",
    "@loaders.gl/core": "4.3.4",
    "@loaders.gl/draco": "./src/@loaders.gl/draco",
    "@loaders.gl/gltf": "./src/@loaders.gl/gltf",
    "@loaders.gl/json": "4.3.4",
    "@loaders.gl/obj": "4.3.4",
    "@loaders.gl/textures": "4.3.4",
    "@loaders.gl/video": "4.3.4",
    "@loaders.gl/zip": "4.3.4",
    "hdrify": "^0.12.1",
    "js-md5": "^0.8.3",
    "ktx-parse": "^1.1.0",
    "webgpu-utils": "^1.11.0",
    "wgpu-matrix": "^3.4.0"
  }
}
